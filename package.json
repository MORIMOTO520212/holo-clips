{
  "name": "holo-clips",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "schema": "ts-json-schema-generator --path src/types.ts --type ClipFile --tsconfig tsconfig.app.json --no-top-ref --out src/data/clip.schema.json",
    "check:data": "node scripts/check-data.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@10.28.1"
}
