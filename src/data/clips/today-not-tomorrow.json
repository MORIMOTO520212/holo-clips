      "end": 6.62,
      "en": "Today! Not tomorrow!",
      "ja": "TODAY! TOMORROWじゃない！"
    },
    {
      "start": 6.62,
      "end": 9.86,
      "en": "TODAY!!! Ah, ah, ah, ah, ah! TODAY!!!",
      "ja": "TOMORROWじゃない！ TODAY～！TODAY～！"
    },
    {
